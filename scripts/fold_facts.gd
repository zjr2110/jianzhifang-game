# 剪纸坊
# fold_facts.gd - 折法对称知识
extends RefCounted

const MATH := {
	"none": "不折：没有折出来的对称，每一刀只出现一次",
	"half": "对折 = 1 条镜面 · 镜像对称，D₁ 群，2 层",
	"four": "四折 = 2 条镜面 + 2 重旋转 · D₂ 群，4 层",
	"eight": "八折 = 4 条镜面 + 4 重旋转 · D₄ 群，8 层",
	"twelve": "六角窗花 = 6 条镜面 + 6 重旋转 · D₆ 群，12 层",
	"sixteen": "十六折 = 8 条镜面 + 8 重旋转 · D₈ 群，16 层",
	"five": "五角折 = 5 条镜面 + 5 重旋转 · D₅ 群，10 层",
	"accordion": "连续拉花 = 等距镜面 + 平移重复 · 饰带对称",
}

const LORE := {
	"none": "剪纸口诀讲「圆如秋月，尖如麦芒，方如青砖，缺如锯齿，线如胡须」，不折全凭刀功。",
	"half": "民间剪「囍」常用对折，一剪下去两个「喜」并肩而立，左右一模一样。",
	"four": "四折展开上下左右都一样，常用来剪方方正正的窗花，贴在窗格正中。",
	"eight": "团花取「团团圆圆」之意，八折团花四面对称，是窗花、顶棚花最常见的样子。",
	"twelve": "古人早有「凡草木花多五出，雪花独六出」之说（《韩诗外传》），六角窗花剪的正是雪花的六重对称。",
	"sixteen": "层数越多越考手上功夫，老话讲剪纸要「千刻不落，万剪不断」。",
	"five": "古人说「草木花多五出」，梅花、桃花都是五瓣，五角折剪的正是花朵的五重对称。",
	"accordion": "一排手拉手的小人就是来回折出来的，展开连绵不断，图个好事成串。",
}


static func math(fold: String) -> String:
	return MATH.get(fold, "")


static func lore(fold: String) -> String:
	return LORE.get(fold, "")
